# ── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-50-chars-minimum
DEBUG=False
ALLOWED_HOSTS=g-moto.gsoft-bf.com

# ── Base de donnees (DB_HOST=db = nom du service Docker) ──────────────────────
DB_NAME=gestion_motos_db
DB_USER=root
DB_PASSWORD=change-this-strong-password
DB_HOST=db
DB_PORT=3306

# ── CORS & CSRF (le frontend est servi par Django meme, donc pas indispensable
#    en usage normal ; utile si un autre site doit appeler l'API) ─────────────
CORS_ALLOWED_ORIGINS=https://g-moto.gsoft-bf.com
CSRF_TRUSTED_ORIGINS=https://g-moto.gsoft-bf.com

# ── Fichiers ──────────────────────────────────────────────────────────────────
MEDIA_URL=/media/
MEDIA_ROOT=media/

# ── Traefik (domaine expose) ────────────────────────────────────────────────
DOMAIN=g-moto.gsoft-bf.com

# ── Superutilisateur cree automatiquement au 1er deploiement ─────────────────
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@gestionmotos.local
SUPERUSER_PASSWORD=change-this-strong-password
